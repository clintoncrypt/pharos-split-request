# Your testnet wallet private key (0x prefixed, 64 hex characters). Use a fresh testnet wallet only.
PRIVATE_KEY=your_testnet_wallet_private_key

# Groq API key (free at https://console.groq.com) - NOT an OpenAI key
OPENAI_API_KEY=your_groq_api_key

# Pharos Atlantic Testnet RPC
RPC_URL=https://atlantic.dplabs-internal.com

# Pharos Atlantic Testnet Chain ID
CHAIN_ID=688689

# Deployed SplitRequest contract address - run 'npm run deploy' first, then paste the output address here
SPLIT_REQUEST_CONTRACT_ADDRESS=
